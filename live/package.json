{
  "name": "cairo-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "build": "tsc --noEmit && vite build && esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.mjs && esbuild src/agent-plugin.ts --bundle --platform=node --format=esm --outfile=dist-electron/agent-plugin.mjs",
    "test": "node --test tests/*.test.mjs",
    "plan": "node src/plan-cli.ts",
    "package": "npm run build && node package.mjs"
  },
  "dependencies": {
    "@opencode/client": "2.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "@opencode/cli": "2.0.22",
    "@opencode/plugin": "2.0.22",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "electron": "44.5.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
