{
  "name": "cairo",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "package:windows": "node scripts/package-windows.mjs",
    "preview:fake": "node --experimental-strip-types scripts/preview-copilot.mjs",
    "test:case": "node --experimental-strip-types scripts/test-case.mjs",
    "dev": "node scripts/build-copilot.mjs && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "node scripts/build-copilot.mjs && vite build"
  },
  "dependencies": {
    "@opencode/cli": "2.0.22",
    "@opencode/client": "2.0.22",
    "@opencode/plugin": "2.0.22",
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-electron": "1.1.2"
  },
  "allowScripts": {
    "@opencode/cli": true,
    "electron@44.5.1": true,
    "esbuild@0.28.2": true
  }
}
